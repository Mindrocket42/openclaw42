#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started_at=$SECONDS
  printf '[ironhead setup] %s\n' "$label"
  "$@"
  printf '[ironhead setup] %s completed in %ss\n' "$label" "$((SECONDS - started_at))"
}

require_command() {
  local command_name="$1"
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf '[ironhead setup] missing required command: %s\n' "$command_name" >&2
    return 1
  fi
}

check_node() {
  require_command node
  node -e 'const major=Number(process.versions.node.split(".")[0]); if (major < 24) { console.error("[ironhead setup] Node 24+ is required; found " + process.versions.node); process.exit(1); }'
}

check_toolchain() {
  require_command git
  require_command corepack

  local package_manager expected actual
  package_manager="$(node -p 'require("./package.json").packageManager')"
  expected="${package_manager#pnpm@}"
  expected="${expected%%+*}"
  actual="$(COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm --version)"
  if [[ "$actual" != "$expected" ]]; then
    printf '[ironhead setup] expected pnpm %s, found %s\n' "$expected" "$actual" >&2
    return 1
  fi
}

install_dependencies() {
  local script_mode=(--ignore-scripts --config.enable-pre-post-scripts=false)
  if [[ "${OPENCLAW_TRUST_DEPENDENCY_SCRIPTS:-0}" == "1" ]]; then
    printf '[ironhead setup] dependency lifecycle scripts explicitly enabled\n'
    script_mode=(--ignore-scripts=false --config.enable-pre-post-scripts=true)
  else
    printf '[ironhead setup] dependency lifecycle scripts disabled by default\n'
  fi

  CI=true COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm install \
    --frozen-lockfile \
    --prefer-offline \
    --config.engine-strict=false \
    --config.side-effects-cache=true \
    "${script_mode[@]}"
}

run_step "Checking Node runtime" check_node
run_step "Checking repository toolchain" check_toolchain
run_step "Installing workspace dependencies" install_dependencies

printf '[ironhead setup] Ready: Node %s, pnpm %s\n' "$(node --version)" "$(COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm --version)"
printf '[ironhead setup] No sudo, system package install, or shell-profile mutation was performed.\n'
